# only run in interactive shell
case $- in
    *i*) ;;
      *) return;;
esac

if [[ -f /etc/skel/.bashrc ]]; then
    echo loading /etc/skel/.bashrc
    . /etc/skel/.bashrc
fi

_chez_find_home() {
    local dir
    local config_file=~/.config/chezmoi/chezmoi.yaml
    if [[ -f $config_file ]]; then
        if dir="$(grep sourceDir $config_file)"; then
            echo "${dir##sourceDir: }"
            return 0
        fi
    fi
    # find in some location
    for dir in ~/work/chezmark ~/work/mark/chezmark ~/.local/share/chezmoi/; do
        if [[ -d $dir ]]; then
            echo "$dir"
            return 0
        fi
    done
    return 1
}

CHEZ_HOME=$(_chez_find_home)
if [[ ! -z ${CHEZ_HOME} ]]; then
    echo using chez dir $CHEZ_HOME
    . "${CHEZ_HOME}/bash/bashrc-main.inc"
fi
[[ -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]] && . "/opt/homebrew/etc/profile.d/bash_completion.sh"
#if [ -f $(brew --prefix)/etc/bash_completion ]; then
#    . $(brew --prefix)/etc/bash_completion
#fi
if [ -f /Users/mark/work/mark/chezmark/bash/bashrc-main.inc ]; then source /Users/mark/work/mark/chezmark/bash/bashrc-main.inc; fi
